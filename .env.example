# ======================================================================
# 🥦 NUTRIFLOW PLATFORM - ECOSYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# ======================================================================

# 🟢 EXPRESS BACKEND SERVER SETTINGS (Port 5000)
PORT=5000
NODE_ENV=production
MONGO_URI="mongodb+srv://user:password@cluster.mongodb.net/nutriflow_db"

# 🔵 NEXT.JS FRONTEND SERVICE SETTINGS (Port 3000)
NEXT_PUBLIC_API_URL="http://localhost:5000"

# 🔐 CRYPTOGRAPHIC SECURITY CAPES (JWT Auth Shield)
JWT_SECRET="generate-at-least-32-chars-long-secure-random-string-here"
JWT_EXPIRES_IN="7d"

# 💳 MONETIZATION & B2C STRIPE SUBSCRIPTIONS (George/Erste Pipeline)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 🚨 SENTRY CENTRALIZED RUNTIME ERROR MONITORING
SENTRY_DSN="https://your-key@o00000.ingest.sentry.io/000000"
